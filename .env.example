# Required: OpenRouter API key for LLM extraction (python -m eee_eval.extraction.extract_paper)
# and for the judge and temperature experiments under experiments/
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Required for the leaderboard / HF model-card fetchers
# (eee_eval.extraction.add_leaderboard_records, hf_model_card_fetcher)
# and for gated models in the GPU experiments:
# a HuggingFace access token. Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: custom CA bundle if TLS verification fails in your environment
# REQUESTS_CA_BUNDLE=/path/to/custom-ca-bundle.crt
