# Every Eval Ever — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# Test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Jupyter
.ipynb_checkpoints/
*.ipynb
# ...except the notebooks that run the experiments
!experiments/**/*.ipynb

# Data directory — large; not committed to git
# (upload to Hugging Face Hub instead)
/data/
# ...but small test fixtures under tests/data/ MUST be tracked so the suite runs
!tests/data/
!tests/data/**

# Raw scraper output and downloaded PDFs go to data/raw/, which /data/ already covers

# Caches
.cache/

# Generated outputs (reproducible). The result files of the experiments under
# experiments/**/results/ are kept in git: the reproduction scripts read them.
/results/
analysis_output/
harness_experiment_output/

# Local working copy of the paper sources
submission/

# Validation reports (generated at runtime)
VALIDATION_REPORT.json
reports/

# macOS
.DS_Store
.localized

# pip / mypy
pip-wheel-metadata/
*.whl
.mypy_cache/
.dmypy.json

# Lock files
uv.lock

# Agent metadata
.claude/
CLAUDE.md
dmypy.json

# Release hygiene
data.zip
section5_evidence.txt
VALIDATION_REPORT.json
.env
# Ad-hoc experiment launchers / logs (scaffolding, not part of the release)
experiments/**/_run_*.sh
experiments/**/_queue_*.sh
experiments/**/auth_start.sh
experiments/**/make_html.sh
experiments/**/results/*.log
