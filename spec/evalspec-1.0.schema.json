            "benchmark_id",
            "scoring_mode",
            "harness_name",
            "harness_version",
            "n_shot",
            "benchmark_variant",
            "evaluation_timestamp",
            "prompt_template_hash"
          ],
          "properties": {
            "model_id": {
              "not": {
                "enum": [
                  "unknown",
                  "",
                  null
                ]
              }
            },
            "benchmark_id": {
              "not": {
                "enum": [
                  "unknown",
                  "",
                  null
                ]
              }
            },
