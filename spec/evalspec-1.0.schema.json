                  "unknown",
                  "",
                  null,
                  "latest",
                  "main",
                  "master",
                  "dev",
                  "nightly",
                  "head",
                  "n/a",
                  "none"
                ]
              }
            },
            "n_shot": {
              "not": {
                "enum": [
                  "unknown",
                  "",
                  null
                ]
              }
            },
            "benchmark_variant": {
              "not": {
                "enum": [
                  "unknown",
                  "",
                  null
