              }
            },
            "evaluation_timestamp": {
              "not": {
                "enum": [
                  "unknown",
                  "",
                  null
                ]
              }
            },
            "prompt_template_hash": {
              "not": {
                "enum": [
                  "unknown",
                  "",
                  null
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "scoring_mode"
            ],
            "properties": {
              "scoring_mode": {
                "enum": [
                  "log-likelihood",
                  "generation",
                  "execution"
                ]
              }
            }
          },
          "else": {
            "required": [
              "judge_model"
            ],
            "properties": {
              "judge_model": {
                "not": {
                  "enum": [
                    "unknown",
                    ""
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "scoring_mode"
            ],
            "properties": {
              "scoring_mode": {
                "const": "generation"
              }
            }
          },
          "then": {
            "required": [
              "answer_parser_version"
            ],
            "properties": {
              "answer_parser_version": {
                "not": {
                  "enum": [
                    "unknown",
                    "",
                    null
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "scoring_mode"
                ],
                "properties": {
                  "scoring_mode": {
                    "const": "preference"
                  }
                }
              },
              {
                "required": [
                  "judge_model"
                ],
                "properties": {
                  "judge_model": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "unknown",
                        ""
                      ]
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "judge_prompt_hash",
              "judge_score_rule"
            ],
            "properties": {
              "judge_prompt_hash": {
                "not": {
                  "enum": [
                    "unknown",
                    "",
                    null
                  ]
                }
              },
              "judge_score_rule": {
                "not": {
                  "enum": [
                    "unknown",
                    "",
                    null
                  ]
                }
              }
            }
          }
        }
      ]
